# ---------------------------------------------------------------------------
# Wedding Studio — cấu hình (copy thành .env)
# ---------------------------------------------------------------------------

# Địa chỉ công khai của website (dùng cho link chia sẻ, ảnh xem trước Zalo/Facebook).
BASE_URL=http://localhost:3000

# Cổng trên máy chủ khi chạy bằng docker compose.
HOST_PORT=3000

# Mật khẩu trang /admin. Để trống = tắt trang quản trị.
ADMIN_PASSWORD=doi-mat-khau-nay

# Khoá ký phiên đăng nhập admin — chuỗi ngẫu nhiên >= 32 ký tự.
# Tạo nhanh: openssl rand -hex 32
SESSION_SECRET=

# Tên thương hiệu hiển thị ở trang chủ & chân thiệp. Để trống để ẩn dòng chân thiệp.
BRAND_NAME=Thiệp Cưới Online

# true  = ai cũng tạo được thiệp (mô hình tự phục vụ)
# false = chỉ admin tạo thiệp (bạn làm thiệp cho khách hàng)
ALLOW_PUBLIC_CREATE=true

# Đặt true khi chạy sau reverse proxy (Caddy/Nginx/Cloudflare) để lấy đúng IP khách.
TRUST_PROXY=false

# Múi giờ của ngày giờ cưới (đếm ngược, file lịch .ics).
WEDDING_TZ_OFFSET=+07:00

# Giới hạn tải lên.
MAX_IMAGE_MB=12
MAX_AUDIO_MB=15
MAX_IMAGES_PER_INVITATION=60

# Xoá file ảnh không còn dùng sau N giờ.
ASSET_GC_GRACE_HOURS=24

# debug | info | warn | error
LOG_LEVEL=info

# --- chỉ dùng với profile https (Caddy) ---
# DOMAIN=thiepcuoi.example.com
