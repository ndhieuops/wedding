{# Floral hero: arch frame + flower clusters (overrides _shared/sections/hero.njk) #}
{% from "macros.njk" import photo %}
{% from "partials/flowers.njk" import cluster %}
<section class="section hero{% if cover.image %} hero--photo{% endif %}" id="hero">
  {% if cover.image %}
  <div class="hero__media">{{ photo(cover.image, 'Ảnh cưới của ' + names, 'hero__img hero__img--' + cover.position, '100vw', true) }}</div>
  {% endif %}
  <div class="hero__arch">
    {{ cluster('flora--top') }}
    <div class="hero__inner">
      {% if guest.name %}<p class="hero__guest" data-reveal="fade">Trân trọng kính mời <strong>{{ guest.name }}</strong></p>{% endif %}
      {% if content.headline %}<p class="hero__eyebrow" data-reveal="fade">{{ content.headline }}</p>{% endif %}
      <h1 class="hero__names" data-reveal="zoom">
        <span class="hero__name">{{ first.shortName }}</span>
        <span class="hero__amp" aria-label="và">&amp;</span>
        <span class="hero__name">{{ second.shortName }}</span>
      </h1>
      {% if wedding.display %}
      <p class="hero__date" data-reveal="up">
        <span class="hero__weekday">{{ wedding.weekday }}</span>
        <span class="hero__date-main">{{ wedding.day }} <i>·</i> {{ wedding.month }} <i>·</i> {{ wedding.year }}</span>
      </p>
      {% if wedding.lunar %}<p class="hero__lunar" data-reveal="up">Nhằm {{ wedding.lunar.text }}</p>{% endif %}
      {% endif %}
    </div>
    {{ cluster('flora--bottom') }}
  </div>
  <a class="hero__scroll" href="#{{ sections[1] or 'thanks' }}" aria-label="Cuộn xuống"><span></span></a>
</section>
