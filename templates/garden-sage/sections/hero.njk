{#
  Vườn Xanh hero: an arched garden gate drawn in fine line art, a eucalyptus garland over the arch,
  olive sprigs climbing the posts and hanging branches in the top corners (overrides _shared/sections/hero.njk).
  A cover photo, when uploaded, sits inside the arch like a view through the gate.
#}
{% from "macros.njk" import photo %}
{% from "partials/botanicals.njk" import corner, arch, base, divider %}
<section class="section hero gs-hero{% if cover.image %} gs-hero--photo{% endif %}" id="hero">
  <div class="gs-hero__light" aria-hidden="true"></div>
  <div class="gs-hero__corner gs-hero__corner--l" aria-hidden="true">{{ corner('gs-corner') }}</div>
  <div class="gs-hero__corner gs-hero__corner--r" aria-hidden="true">{{ corner('gs-corner') }}</div>

  <div class="gs-gate">
    <div class="gs-gate__frame" aria-hidden="true">
      {{ arch() }}
      <span class="gs-gate__post gs-gate__post--l"></span>
      <span class="gs-gate__post gs-gate__post--r"></span>
      {{ base() }}
    </div>

    <div class="gs-gate__inner hero__inner">
      {% if cover.image %}
      <figure class="gs-hero__photo" data-reveal="zoom">
        {{ photo(cover.image, 'Ảnh cưới của ' + names, 'gs-hero__img hero__img--' + cover.position, '(max-width: 600px) 80vw, 420px', true) }}
      </figure>
      {% endif %}
      {% if guest.name %}
      <p class="hero__guest" data-reveal="fade"><span>Trân trọng kính mời</span> <strong>{{ guest.name }}</strong></p>
      {% endif %}
      <p class="hero__eyebrow" data-reveal="fade">{{ content.headline or 'Save the Date' }}</p>
      <h1 class="hero__names" data-names data-reveal="zoom">
        <span class="hero__name">{{ first.shortName }}</span>
        <span class="hero__amp" aria-label="và">&amp;</span>
        <span class="hero__name">{{ second.shortName }}</span>
      </h1>
      {{ divider('gs-hero__divider') }}
      {% if wedding.display %}
      <div class="gs-hero__date" data-reveal="up">
        <span class="gs-hero__weekday">{{ wedding.weekday }}</span>
        <span class="gs-hero__dmy">
          <span>{{ wedding.day }}</span><i aria-hidden="true"></i><span>{{ wedding.month }}</span><i aria-hidden="true"></i><span>{{ wedding.year }}</span>
        </span>
        {% if wedding.lunar %}
        {# keep "ngày … tháng …" and "năm …" together so the line never breaks between "tháng" and its number #}
        {% set lunarParts = wedding.lunar.text.split(' năm ') %}
        <span class="gs-hero__lunar">{% if lunarParts.length == 2 %}<span>Nhằm {{ lunarParts[0] }}</span> <span>năm {{ lunarParts[1] }}</span>{% else %}Nhằm {{ wedding.lunar.text }}{% endif %}</span>
        {% endif %}
      </div>
      {% endif %}
    </div>
  </div>

  <a class="hero__scroll" href="#{{ sections[1] or 'thanks' }}" aria-label="Cuộn xuống"><span></span></a>
</section>
