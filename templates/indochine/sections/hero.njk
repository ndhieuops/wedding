{#
  Đông Dương hero: a colonial arched window (sunburst fanlight, half-open louvered shutters, sill)
  on a lime-washed wall, banana & palm leaves behind it and a strip of gạch bông floor tiles.
  Without a cover photo the names sit inside the window; with one, the photo fills the window
  and the names move onto the wall below.
#}
{% from "macros.njk" import photo %}
{% set heroText %}
  <div class="ind-hero__text">
    <p class="hero__eyebrow" data-reveal="fade">{{ content.headline or 'Lễ Thành Hôn' }}</p>
    <h1 class="hero__names" data-names data-reveal="zoom">
      <span class="hero__name">{{ first.shortName }}</span>
      <span class="hero__amp" aria-label="và">&amp;</span>
      <span class="hero__name">{{ second.shortName }}</span>
    </h1>
    {% if wedding.display %}
    <p class="hero__date" data-reveal="up">
      <span class="hero__weekday">{{ wedding.weekday }}{% if wedding.time %} · {{ wedding.time }}{% endif %}</span>
      <span class="hero__date-main">{{ wedding.day }}<i aria-hidden="true"></i>{{ wedding.month }}<i aria-hidden="true"></i>{{ wedding.year }}</span>
    </p>
    {% if wedding.lunar %}<p class="hero__lunar" data-reveal="up">Nhằm {{ wedding.lunar.text }}</p>{% endif %}
    {% endif %}
  </div>
{% endset %}
<section class="section hero ind-hero{% if cover.image %} ind-hero--photo{% endif %}" id="hero">
  <div class="ind-hero__flora" aria-hidden="true">
    <span class="ind-leaf ind-leaf--palm"></span>
    <span class="ind-leaf ind-leaf--back-l"></span>
    <span class="ind-leaf ind-leaf--back-r"></span>
  </div>

  <div class="ind-hero__stage">
    {% if guest.name %}<p class="hero__guest" data-reveal="fade">Trân trọng kính mời <strong>{{ guest.name }}</strong></p>{% endif %}

    <div class="ind-window" data-reveal="rise">
      <span class="ind-shutter ind-shutter--left" aria-hidden="true"></span>
      <span class="ind-shutter ind-shutter--right" aria-hidden="true"></span>
      <div class="ind-window__frame">
        <span class="ind-window__fan" aria-hidden="true"></span>
        <div class="ind-window__pane">
          {% if cover.image %}
          {{ photo(cover.image, 'Ảnh cưới của ' + names, 'ind-window__img hero__img--' + cover.position, '(max-width: 600px) 80vw, 420px', true) }}
          {% else %}
          {{ heroText | safe }}
          {% endif %}
        </div>
      </div>
      <span class="ind-window__sill" aria-hidden="true"></span>
    </div>

    {% if cover.image %}{{ heroText | safe }}{% endif %}
  </div>

  <div class="ind-hero__flora ind-hero__flora--front" aria-hidden="true">
    <span class="ind-leaf ind-leaf--front-l"></span>
    <span class="ind-leaf ind-leaf--front-r"></span>
  </div>
  <div class="ind-floor" aria-hidden="true"></div>
  <a class="hero__scroll" href="#{{ sections[1] or 'thanks' }}" aria-label="Cuộn xuống"><span></span></a>
</section>
