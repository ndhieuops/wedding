{#
  Sen Việt — inline lotus ornaments. Every colour comes from the theme through the
  .lt-* classes in style.css (fill/stroke = var(--c-*) + color-mix), so palettes just work.
  defs() must be rendered once per page (index.njk → block background).
#}

{% macro defs() %}
<svg class="lh-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="lh-g-front" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="lt-stop-tip"/><stop offset=".55" class="lt-stop-mid"/><stop offset="1" class="lt-stop-base"/></linearGradient>
    <linearGradient id="lh-g-back" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="lt-stop-tip2"/><stop offset="1" class="lt-stop-base2"/></linearGradient>
    <path id="lh-p" d="M0-140C8-134 27-112 28-84C29-52 16-18 0 0C-16-18-29-52-28-84C-27-112-8-134 0-140Z"/>
    <path id="lh-pv" d="M0-6C2-50 1-100 0-128M-2-10C-11-40-17-76-13-108M2-10C11-40 17-76 13-108"/>
    <path id="lh-w" d="M0-98C10-94 35-78 37-50C38-24 19-6 0 0C-19-6-38-24-37-50C-35-78-10-94 0-98Z"/>
    <path id="lh-wv" d="M0-6C1-36 1-62 0-86M-3-8C-14-28-20-52-17-74M3-8C14-28 20-52 17-74"/>
  </defs>
</svg>
{% endmacro %}

