{#
  Biển Xanh — beach wedding.
  Every section gets a "tone" (sand · foam · deep · dusk) and the animated wave dividers between them
  blend one tone into the next, so the page reads like walking from the sea up the beach.
#}
{% extends "layout.njk" %}

{% macro tone(name, idx) -%}
{%- if name == 'hero' %}sky{% elif name == 'quote' %}deep{% elif name == 'thanks' %}dusk{% elif idx % 2 == 0 %}foam{% else %}sand{% endif -%}
{%- endmacro %}

{% macro wave(from, to, deco='', side='left', hidden=false) %}
<div class="ob-wave ob-wave--from-{{ from }} ob-wave--to-{{ to }}{% if hidden %} ob-wave--hidden{% endif %}" aria-hidden="true">
  {% if not hidden %}
  <span class="ob-wave__sea">
    <span class="ob-wave__layer ob-wave__layer--back"></span>
    <span class="ob-wave__layer ob-wave__layer--mid"></span>
    <span class="ob-wave__crest"><span class="ob-wave__layer ob-wave__layer--front"></span></span>
  </span>
  {% if deco %}<span class="ob-wave__deco ob-wave__deco--{{ side }}" data-parallax="0.07"><i class="ob-deco ob-deco--{{ deco }}"></i></span>{% endif %}
  {% endif %}
</div>
{% endmacro %}

{% block sections %}
  {% set decos = ['starfish', '', 'shell', ''] %}
  {% for section in sections %}
    {% set curTone = tone(section, loop.index) | trim %}
    {% set nextName = sections[loop.index] if not loop.last else '' %}
    {% set obNextTone = (tone(nextName, loop.index + 1) | trim) if nextName else 'sand' %}
    {% include "sections/" + section + ".njk" %}
    {% if not loop.last %}
      {% set fromTone = 'deep' if curTone == 'dusk' else curTone %}
      {{ wave(fromTone, obNextTone, decos[loop.index0 % 4], 'right' if loop.index0 % 8 < 4 else 'left', section == 'hero') }}
    {% endif %}
  {% endfor %}
{% endblock %}
