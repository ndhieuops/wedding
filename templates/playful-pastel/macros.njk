{#
  Kẹo Ngọt — overrides _shared/macros.njk (every macro is kept; title() and divider() are restyled).
  Section title: a tilted candy sticker (script line) above a bold title with a highlighter stripe,
  then a wavy squiggle + heart divider.
#}
{% from "partials/candy.njk" import sticker, squiggle %}

{% macro title(main, sub='', script='') %}
<header class="section-title pp-title" data-reveal="up">
  {% if script %}<p class="section-title__script"><span class="pp-title__badge">{{ script }}</span></p>{% endif %}
  <h2 class="section-title__main"><span class="pp-title__mark">{{ main }}</span></h2>
  {% if sub %}<p class="section-title__sub">{{ sub }}</p>{% endif %}
  <span class="section-title__divider" aria-hidden="true">{{ divider() }}</span>
</header>
{% endmacro %}

{% macro divider() %}
<span class="pp-divider">{{ squiggle('pp-squiggle--l') }}{{ sticker('heart', 'pp-st--pink pp-divider__heart') }}{{ squiggle('pp-squiggle--r') }}</span>
{% endmacro %}

{% macro heart(size=16) %}
<svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-10-9.3C.4 8.4 2.3 4.5 6 4.1c2.1-.2 3.9.9 6 3.2 2.1-2.3 3.9-3.4 6-3.2 3.7.4 5.6 4.3 4 7.6C19.5 16.4 12 21 12 21Z"/></svg>
{% endmacro %}

{% macro icon(name, size=18) %}
<svg class="icon icon--{{ name }}" viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == 'map' %}<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 1 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>
{% elif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{% elif name == 'calendar' %}<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
{% elif name == 'copy' %}<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
{% elif name == 'gift' %}<rect x="3.5" y="9" width="17" height="11.5" rx="1.5"/><path d="M2.5 9h19M12 9v11.5M12 9S10.5 4 7.8 4.6C5.6 5.1 6.5 9 12 9Zm0 0s1.5-5 4.2-4.4C18.4 5.1 17.5 9 12 9Z"/>
{% elif name == 'music' %}<path d="M9 18V5l11-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/>
{% elif name == 'send' %}<path d="M21 3 10.5 13.5M21 3l-6.5 18-4-7.5L3 9.5 21 3Z"/>
{% elif name == 'phone' %}<path d="M5 3.5h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.6 6.6l1.4-2.3 4.5 1.8V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z"/>
{% else %}<circle cx="12" cy="12" r="9"/>
{% endif %}
</svg>
{% endmacro %}

{% macro photo(ref, alt='', cls='', sizes='100vw', eager=false) %}
{% if ref %}
<img class="{{ cls }}" src="{{ ref.url }}"{% if ref.thumb %} srcset="{{ ref.thumb }} 640w, {{ ref.url }} {{ ref.w or 2000 }}w" sizes="{{ sizes }}"{% endif %}{% if ref.w and ref.h %} width="{{ ref.w }}" height="{{ ref.h }}"{% endif %} alt="{{ alt }}" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
{% endif %}
{% endmacro %}
