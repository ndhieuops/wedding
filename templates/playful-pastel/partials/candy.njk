{#
  Kẹo Ngọt — sticker sprite. Rendered once (index.njk → background block) and reused with <use>.
  Colours come from the theme through CSS on the outer <svg class="pp-st ...">:
    fill  → sticker body (pastel)    stroke → ink outline (--c-text)    color → shine / white parts (--c-surface)
#}
{% macro sprite() %}
<svg class="pp-sprite" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
  <symbol id="pp-heart" viewBox="-4 -4 72 72">
    <path d="M32 56C22 48 6 38.5 6 22.5 6 13.6 12.6 7 21 7c5 0 8.6 2.6 11 6.6C34.4 9.6 38 7 43 7c8.4 0 15 6.6 15 15.5C58 38.5 42 48 32 56Z" stroke-width="3.2" stroke-linejoin="round"/>
    <path d="M14.2 21c.5-4 3.2-6.8 7-7.3" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round"/>
  </symbol>
  <symbol id="pp-star" viewBox="-4 -4 72 72">
    <path d="M32 6l7.6 17.5 19 1.8-14.2 12.7 4.1 18.7L32 47l-16.5 9.7 4.1-18.7L5.4 25.3l19-1.8Z" stroke-width="3.2" stroke-linejoin="round"/>
    <path d="M27.4 24.6l2.5-5.6" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/>
  </symbol>
  <symbol id="pp-sparkle" viewBox="-2 -2 68 68">
    <path d="M32 4c2 17 11 26 28 28-17 2-26 11-28 28-2-17-11-26-28-28 17-2 26-11 28-28Z" stroke-width="3" stroke-linejoin="round"/>
  </symbol>
  <symbol id="pp-daisy" viewBox="-4 -4 72 72">
    <g fill="currentColor" stroke-width="2.8"><ellipse cx="32" cy="14.5" rx="7.2" ry="11"/><ellipse cx="32" cy="14.5" rx="7.2" ry="11" transform="rotate(45 32 32)"/><ellipse cx="32" cy="14.5" rx="7.2" ry="11" transform="rotate(90 32 32)"/><ellipse cx="32" cy="14.5" rx="7.2" ry="11" transform="rotate(135 32 32)"/><ellipse cx="32" cy="14.5" rx="7.2" ry="11" transform="rotate(180 32 32)"/><ellipse cx="32" cy="14.5" rx="7.2" ry="11" transform="rotate(225 32 32)"/><ellipse cx="32" cy="14.5" rx="7.2" ry="11" transform="rotate(270 32 32)"/><ellipse cx="32" cy="14.5" rx="7.2" ry="11" transform="rotate(315 32 32)"/></g>
    <circle cx="32" cy="32" r="9.5" stroke-width="2.8"/>
  </symbol>
  <symbol id="pp-candy" viewBox="-4 -4 104 56">
    <path d="M31 17 9 5.5c3.2 12 3.2 25 0 37L31 31Z" stroke-width="3" stroke-linejoin="round"/>
    <path d="M65 17 87 5.5c-3.2 12-3.2 25 0 37L65 31Z" stroke-width="3" stroke-linejoin="round"/>
    <path d="M14.5 14.5 24 20M14.5 33.5 24 28M81.5 14.5 72 20M81.5 33.5 72 28" fill="none" stroke-width="2.2" stroke-linecap="round"/>
    <ellipse cx="48" cy="24" rx="19.5" ry="15.5" stroke-width="3"/>
    <path d="M40.5 11.2c-3.4 8.4-3.4 17.2 0 25.6M50.5 9c-3.6 10-3.6 20 0 30M60 12.6c-3 7.6-3 15.2 0 22.8" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/>
  </symbol>
  <symbol id="pp-lolly" viewBox="-4 -4 72 104">
    <rect x="29" y="52" width="6" height="44" rx="3" fill="currentColor" stroke-width="2.8"/>
    <circle cx="32" cy="30" r="26" stroke-width="3.2"/>
    <path d="M32 30a3 3 0 0 1 6 0a6 6 0 0 1-12 0a9 9 0 0 1 18 0a12 12 0 0 1-24 0a15 15 0 0 1 30 0a18 18 0 0 1-36 0" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
  </symbol>
</svg>
{% endmacro %}

{# One sticker. name: heart · star · sparkle · daisy · candy · lolly ; cls adds colour/position classes. #}
{% macro sticker(name, cls='') %}<svg class="pp-st pp-st--{{ name }} {{ cls }}" aria-hidden="true" focusable="false"><use href="#pp-{{ name }}"/></svg>{% endmacro %}

{# Wavy squiggle used by section titles. #}
{% macro squiggle(cls='') %}<svg class="pp-squiggle {{ cls }}" viewBox="0 0 64 14" aria-hidden="true" focusable="false"><path d="M3 7c4.8-5.4 9.2-5.4 14 0s9.2 5.4 14 0 9.2-5.4 14 0 9.2 5.4 14 0"/></svg>{% endmacro %}
