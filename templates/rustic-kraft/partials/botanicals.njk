  </g>
  <g class="rk-bot__leaf">
    <ellipse cx="68" cy="16" rx="7" ry="2.6" transform="rotate(-14 68 16)"/><ellipse cx="72" cy="27" rx="6.5" ry="2.4" transform="rotate(16 72 27)"/>
    <ellipse cx="130" cy="17" rx="7" ry="2.6" transform="rotate(12 130 17)"/><ellipse cx="128" cy="28" rx="6.5" ry="2.4" transform="rotate(-16 128 28)"/>
  </g>
  <g class="rk-bot__bud">
    <ellipse cx="12" cy="12.5" rx="3.6" ry="2" transform="rotate(8 12 12.5)"/><ellipse cx="18" cy="11" rx="3.2" ry="1.9" transform="rotate(-30 18 11)"/><ellipse cx="19" cy="16" rx="3.2" ry="1.9" transform="rotate(30 19 16)"/>
