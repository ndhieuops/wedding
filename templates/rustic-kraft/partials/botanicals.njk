  </g>
  <g class="rk-bot__dot">
    <circle cx="34" cy="31" r="2"/><circle cx="29" cy="28" r="1.6"/><circle cx="30" cy="34" r="1.5"/><circle cx="38" cy="35" r="1.4"/>
