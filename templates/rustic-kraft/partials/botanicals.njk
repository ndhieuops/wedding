    <ellipse cx="33" cy="18" rx="3" ry="1.8" transform="rotate(30 33 18)"/><ellipse cx="39" cy="14.5" rx="2.6" ry="1.6" transform="rotate(-25 39 14.5)"/>
    <ellipse cx="38" cy="8" rx="3" ry="1.8" transform="rotate(10 38 8)"/><ellipse cx="44" cy="9" rx="2.6" ry="1.6" transform="rotate(-25 44 9)"/>
  </g>
  <g class="rk-bot__grain">
