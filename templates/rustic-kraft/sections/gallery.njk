{# Mộc Mạc gallery: a board of taped polaroids (overrides _shared/sections/gallery.njk; keeps data-lightbox). #}
{% from "macros.njk" import title %}
<section class="section gallery" id="gallery">
  <div class="container container--wide">
    {{ title('Album Ảnh Cưới', '', 'Our Moments') }}
    <div class="gallery__grid rk-board" data-gallery>
      {% for item in gallery %}
      <a class="gallery__item rk-snap" href="{{ item.image.url }}" data-lightbox data-index="{{ loop.index0 }}"{% if item.caption %} data-caption="{{ item.caption }}"{% endif %} data-reveal="zoom">
        <span class="rk-snap__frame">
          <img src="{{ item.image.thumb or item.image.url }}"{% if item.image.w and item.image.h %} width="{{ item.image.w }}" height="{{ item.image.h }}"{% endif %} alt="{{ item.caption or ('Ảnh cưới ' + loop.index) }}" loading="lazy" decoding="async">
        </span>
        <span class="rk-snap__caption" aria-hidden="true">{{ item.caption or ('#' + (loop.index | string)) }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
