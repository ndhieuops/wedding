{#
  Mộc Mạc hero: a kraft luggage tag hanging on twine, a cream hand-written label, a dried-flower
  bundle tucked under the string, a postage stamp and a round postmark with the date.
  With a cover photo, the photo becomes a taped polaroid next to (mobile: above) the tag.
#}
{% from "macros.njk" import photo %}
{% from "partials/botanicals.njk" import bouquet, sprig %}
<section class="section hero rk-hero{% if cover.image %} rk-hero--photo{% endif %}" id="hero">
  <span class="rk-hero__mark rk-hero__mark--a" aria-hidden="true"></span>
  <span class="rk-hero__mark rk-hero__mark--b" aria-hidden="true"></span>
  {{ bouquet('rk-hero__side rk-hero__side--left') }}
  {{ bouquet('rk-hero__side rk-hero__side--right') }}

  <div class="rk-hero__board">
    {% if cover.image %}
    <figure class="rk-hero__photo" data-reveal="drop">
      <span class="rk-hero__photo-frame">{{ photo(cover.image, 'Ảnh cưới của ' + names, 'rk-hero__img hero__img--' + cover.position, '(max-width: 760px) 78vw, 420px', true) }}</span>
      <figcaption class="rk-hero__photo-caption" aria-hidden="true">{{ first.shortName }} &amp; {{ second.shortName }}</figcaption>
    </figure>
    {% endif %}

    <div class="rk-hero__hang">
      <span class="rk-hero__string" aria-hidden="true"></span>
      <div class="rk-hero__tag" data-reveal="rise">
        <div class="rk-hero__tagbody">
          <div class="rk-hero__label">
            {% if guest.name %}
            <p class="hero__guest rk-hero__to" data-reveal="fade"><span class="rk-hero__to-label">Kính gửi</span> <strong>{{ guest.name }}</strong></p>
            {% endif %}
            <p class="hero__eyebrow" data-reveal="fade">{{ content.headline or 'Save the Date' }}</p>
            <h1 class="hero__names" data-names data-reveal="zoom">
              <span class="hero__name">{{ first.shortName }}</span>
              <span class="hero__amp" aria-label="và">&amp;</span>
              <span class="hero__name">{{ second.shortName }}</span>
            </h1>
            <span class="rk-hero__sprig" aria-hidden="true">{{ sprig() }}</span>
            {% if wedding.display %}
            <p class="hero__date" data-reveal="up">
              <span class="hero__weekday">{{ wedding.weekday }}</span>
              <span class="hero__date-main">{{ wedding.day }}<i>.</i>{{ wedding.month }}<i>.</i>{{ wedding.year }}</span>
            </p>
            {% if wedding.lunar %}<p class="hero__lunar" data-reveal="up">Nhằm {{ wedding.lunar.text }}</p>{% endif %}
            {% endif %}
          </div>
        </div>
        <span class="rk-hero__eyelet" aria-hidden="true"></span>
        <span class="rk-hero__knot" aria-hidden="true"></span>
        {{ bouquet('rk-hero__bouquet') }}
        <span class="rk-stamp rk-hero__stamp" aria-hidden="true">
          <span class="rk-stamp__art">
            <span class="rk-stamp__mono">{{ first.initial }}<i>&amp;</i>{{ second.initial }}</span>
            <span class="rk-stamp__value">{{ wedding.year or 'Love' }}</span>
          </span>
        </span>
        {% if wedding.display %}
        <svg class="rk-postmark rk-hero__postmark" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
          <defs><path id="rk-ring" d="M60 60m-41 0a41 41 0 1 1 82 0a41 41 0 1 1-82 0"/></defs>
          <circle class="rk-postmark__ring" cx="60" cy="60" r="55"/>
          <circle class="rk-postmark__ring rk-postmark__ring--thin" cx="60" cy="60" r="31"/>
          <text class="rk-postmark__arc"><textPath href="#rk-ring" textLength="252" lengthAdjust="spacing">{{ wedding.weekday }} ✦ Lễ thành hôn ✦</textPath></text>
          <text class="rk-postmark__day" x="60" y="62" text-anchor="middle">{{ wedding.day }}.{{ wedding.month }}</text>
          <text class="rk-postmark__year" x="60" y="78" text-anchor="middle">{{ wedding.year }}</text>
        </svg>
        {% endif %}
      </div>
    </div>
  </div>
  <a class="hero__scroll" href="#{{ sections[1] or 'thanks' }}" aria-label="Cuộn xuống"><span></span></a>
</section>
