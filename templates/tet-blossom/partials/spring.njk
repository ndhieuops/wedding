{% macro phao(cls='', pairs=8) %}
{% set h = 62 + pairs * 12 %}
<svg class="tb-phao {{ cls }}" viewBox="-30 0 60 {{ h + 44 }}" aria-hidden="true" focusable="false">
  <path class="tb-cord" d="M0 0V{{ h + 8 }}"/>
  <g transform="translate(0 30)">
    <circle class="tb-knot__loop" cx="-13.5" r="3.6"/><circle class="tb-knot__loop" cx="13.5" r="3.6"/><circle class="tb-knot__loop" cy="-13.5" r="3.6"/>
    <rect class="tb-knot" x="-9.5" y="-9.5" width="19" height="19" rx="2.6" transform="rotate(45)"/>
    <rect class="tb-knot__inner" x="-5.2" y="-5.2" width="10.4" height="10.4" rx="1.4" transform="rotate(45)"/>
  </g>
  <g class="tb-phao__crackers">
  {% for i in range(0, pairs) %}{% set y = 56 + i * 12 %}
    <use href="#tb-cracker" transform="translate(0 {{ y }}) rotate({{ 60 - (i % 2) * 8 }})"/>
    <use href="#tb-cracker" transform="translate(0 {{ y + 6 }}) rotate({{ -60 + (i % 2) * 8 }})"/>
  {% endfor %}
  </g>
  <g transform="translate(0 {{ h + 10 }})">
    <circle class="tb-knot" r="4.4"/>
    <rect class="tb-cracker__band" x="-3.8" y="3.6" width="7.6" height="4.4" rx="1.2"/>
    <path class="tb-tassel" d="M-3 8.4-5.6 31M-1.5 8.4-2.6 33M0 8.4V34M1.5 8.4 2.6 33M3 8.4 5.6 31"/>
  </g>
</svg>
{% endmacro %}

{% macro sprig(cls='') %}
<svg class="tb-sprig {{ cls }}" viewBox="0 0 220 40" aria-hidden="true" focusable="false">
  <path class="tb-sprig__line" d="M6 21H72M148 21h66"/>
  <g class="tb-bark"><path stroke-width="2" d="M80 25c18-6 40-8 60-4"/><path stroke-width="1.4" d="M98 21c4-7 10-11 18-12"/></g>
  <use href="#tb-leaf" transform="translate(86 23) rotate(160) scale(0.8)"/><use href="#tb-mai-bud" transform="translate(140 21) rotate(80) scale(0.9)"/><use href="#tb-dao-bud" transform="translate(116 9) rotate(60) scale(0.8)"/>
  <use href="#tb-dao" transform="translate(92 22) rotate(10) scale(0.95)"/><use href="#tb-mai" transform="translate(118 20) rotate(20) scale(1.15)"/>
  <circle class="tb-sprig__dot" cx="72" cy="21" r="1.8"/><circle class="tb-sprig__dot" cx="148" cy="21" r="1.8"/>
</svg>
{% endmacro %}

{% macro hy(cls='') %}
<span class="tb-hy {{ cls }}" aria-hidden="true"><span class="tb-hy__glyph">囍</span></span>
{% endmacro %}
