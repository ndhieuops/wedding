  <use href="#tb-leaf" transform="translate(60 25) rotate(-150) scale(1)"/><use href="#tb-leaf" transform="translate(88 92) rotate(160) scale(1)"/><use href="#tb-leaf" transform="translate(150 90) rotate(-70) scale(1)"/><use href="#tb-leaf" transform="translate(230 157) rotate(30) scale(0.9)"/><use href="#tb-leaf" transform="translate(118 60) rotate(20) scale(1)"/><use href="#tb-leaf" transform="translate(190 66) rotate(-100) scale(0.8)"/>
  <use href="#tb-mai-bud" transform="translate(110 4) rotate(70) scale(1)"/><use href="#tb-mai-bud" transform="translate(62 104) rotate(-100) scale(1)"/><use href="#tb-mai-bud" transform="translate(228 60) rotate(90) scale(1)"/><use href="#tb-mai-bud" transform="translate(258 172) rotate(125) scale(1)"/><use href="#tb-mai-bud" transform="translate(202 176) rotate(200) scale(1)"/><use href="#tb-mai-bud" transform="translate(44 22) rotate(-40) scale(0.9)"/><use href="#tb-mai-bud" transform="translate(154 98) rotate(150) scale(0.9)"/>
  <use href="#tb-mai" transform="translate(28 16) rotate(10) scale(1.25)"/><use href="#tb-mai" transform="translate(124 2) rotate(40) scale(1.1)"/><use href="#tb-mai" transform="translate(74 20) rotate(-20) scale(0.85)"/><use href="#tb-mai" transform="translate(92 47) rotate(15) scale(1.5)"/><use href="#tb-mai" transform="translate(90 118) rotate(-10) scale(1.2)"/><use href="#tb-mai" transform="translate(50 106) rotate(30) scale(0.95)"/><use href="#tb-mai" transform="translate(141 83) rotate(50) scale(1.05)"/><use href="#tb-mai" transform="translate(214 64) rotate(0) scale(1.25)"/><use href="#tb-mai" transform="translate(210 40) rotate(20) scale(0.8)"/><use href="#tb-mai" transform="translate(176 66) rotate(-30) scale(0.85)"/><use href="#tb-mai" transform="translate(168 112) rotate(25) scale(1.35)"/><use href="#tb-mai" transform="translate(236 160) rotate(-15) scale(1.1)"/><use href="#tb-mai" transform="translate(278 192) rotate(10) scale(0.9)"/><use href="#tb-mai" transform="translate(196 192) rotate(35) scale(1)"/><use href="#tb-mai" transform="translate(120 92) rotate(5) scale(0.7)"/>
</svg>
{% endmacro %}

