<svg class="tb-branch tb-branch--dao {{ cls }}" viewBox="0 0 300 220" aria-hidden="true" focusable="false">
  <g class="tb-bark"><path stroke-width="7" d="M308 216c-36-16-66-30-94-52"/><path stroke-width="5.5" d="M214 164c-26-20-44-42-62-68"/><path stroke-width="4" d="M152 96c-14-20-30-34-54-44"/><path stroke-width="2.6" d="M98 52c-16-6-32-8-50-6"/><path stroke-width="3" d="M248 192c-12-24-16-46-12-72"/><path stroke-width="2" d="M236 140c14-12 26-20 44-24"/><path stroke-width="3" d="M182 134c-20 6-40 16-62 34"/><path stroke-width="2" d="M142 151c-8 15-12 25-12 39"/><path stroke-width="2.4" d="M128 70c0-18 6-34 18-48"/></g>
  <use href="#tb-leaf" transform="translate(226 160) rotate(200) scale(0.9)"/><use href="#tb-leaf" transform="translate(140 84) rotate(-120) scale(0.8)"/><use href="#tb-leaf" transform="translate(104 56) rotate(170) scale(0.8)"/>
  <use href="#tb-dao-bud" transform="translate(262 120) rotate(60) scale(1)"/><use href="#tb-dao-bud" transform="translate(70 44) rotate(-80) scale(1)"/><use href="#tb-dao-bud" transform="translate(138 32) rotate(-20) scale(1)"/><use href="#tb-dao-bud" transform="translate(108 178) rotate(-130) scale(1)"/><use href="#tb-dao-bud" transform="translate(196 150) rotate(200) scale(0.9)"/><use href="#tb-dao-bud" transform="translate(30 48) rotate(-90) scale(0.9)"/>
