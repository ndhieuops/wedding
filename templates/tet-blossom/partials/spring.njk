{#
  Xuân Hỷ — spring ornaments (generated, hand-tuned). Every colour comes from the theme through
  CSS custom properties (see style.css → "ornament colours"), so all palettes recolour them.
  defs()   : the shared <defs> (flowers, buds, leaf, firecracker) — rendered once in index.njk
  mai()    : yellow apricot-blossom branch      dao(): pink peach-blossom branch
  phao()   : hanging firecracker garland        sprig(): small divider twig
  hy()     : red lucky-paper diamond with a gold 囍
#}
{% macro defs() %}
<svg class="tb-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <path id="tb-mp" d="M0 0C-5.4-1.9-7.8-8.4-4-11.7c2-1.7 6-1.7 8 0C7.8-8.4 5.4-1.9 0 0Z"/>
    <path id="tb-dp" d="M0 0C-6-1.5-9.4-8-5.4-11.8c1.7-1.5 3.8-1.3 5.4.7 1.6-2 3.7-2.2 5.4-.7C9.4-8 6-1.5 0 0Z"/>
    <g id="tb-mai">
      <g class="tb-mai__petals"><use href="#tb-mp"/><use href="#tb-mp" transform="rotate(72)"/><use href="#tb-mp" transform="rotate(144)"/><use href="#tb-mp" transform="rotate(216)"/><use href="#tb-mp" transform="rotate(288)"/></g>
      <circle class="tb-mai__glow" r="5.2"/>
      <path class="tb-mai__stamen" d="M0 0L1.5 -7.3M0 0L4.7 -3.8M0 0L7.4 0.2M0 0L4.5 4M0 0L1.1 7.3M0 0L-3.2 5.2M0 0L-7 2.4M0 0L-5.6 -2.2M0 0L-3.5 -6.5"/>
      <g class="tb-mai__tip"><circle cx="1.5" cy="-7.3" r=".95"/><circle cx="4.7" cy="-3.8" r=".95"/><circle cx="7.4" cy="0.2" r=".95"/><circle cx="4.5" cy="4" r=".95"/><circle cx="1.1" cy="7.3" r=".95"/><circle cx="-3.2" cy="5.2" r=".95"/><circle cx="-7" cy="2.4" r=".95"/><circle cx="-5.6" cy="-2.2" r=".95"/><circle cx="-3.5" cy="-6.5" r=".95"/></g>
      <circle class="tb-mai__eye" r="2.2"/>
    </g>
    <g id="tb-dao">
      <g class="tb-dao__petals"><use href="#tb-dp" transform="rotate(36)"/><use href="#tb-dp" transform="rotate(108)"/><use href="#tb-dp" transform="rotate(180)"/><use href="#tb-dp" transform="rotate(252)"/><use href="#tb-dp" transform="rotate(324)"/></g>
      <circle class="tb-dao__blush" r="5.6"/>
      <path class="tb-dao__stamen" d="M0 0L1.3 -6.5M0 0L4.2 -3.4M0 0L6.6 0.2M0 0L4.1 3.6M0 0L1 6.5M0 0L-2.8 4.6M0 0L-6.3 2.1M0 0L-5 -2M0 0L-3.2 -5.8"/>
      <g class="tb-dao__tip"><circle cx="1.3" cy="-6.5" r=".9"/><circle cx="4.2" cy="-3.4" r=".9"/><circle cx="6.6" cy="0.2" r=".9"/><circle cx="4.1" cy="3.6" r=".9"/><circle cx="1" cy="6.5" r=".9"/><circle cx="-2.8" cy="4.6" r=".9"/><circle cx="-6.3" cy="2.1" r=".9"/><circle cx="-5" cy="-2" r=".9"/><circle cx="-3.2" cy="-5.8" r=".9"/></g>
    </g>
    <g id="tb-mai-bud"><ellipse class="tb-mai__bud" cy="-4.6" rx="3.3" ry="4.8"/><path class="tb-sepal" d="M-3.2-1.6C-2 1.2 2 1.2 3.2-1.6L0 2.6Z"/></g>
    <g id="tb-dao-bud"><ellipse class="tb-dao__bud" cy="-4.6" rx="3.4" ry="4.6"/><path class="tb-sepal" d="M-3.2-1.6C-2 1.2 2 1.2 3.2-1.6L0 2.6Z"/></g>
    <path id="tb-leaf" class="tb-leaf" d="M0 0C3.6-4.2 10.4-5.6 15.4-2.8 10.8.8 4.6 1.8 0 0Z"/>
    <g id="tb-cracker">
      <path class="tb-wick" d="M0 0v4.4"/>
      <rect class="tb-cracker__body" x="-4.3" y="3.6" width="8.6" height="19" rx="1.8"/>
      <rect class="tb-cracker__band" x="-4.3" y="3.6" width="8.6" height="2.8" rx="1.2"/>
      <rect class="tb-cracker__band" x="-4.3" y="19.8" width="8.6" height="2.8" rx="1.2"/>
      <rect class="tb-cracker__shine" x="-2.7" y="7.4" width="1.5" height="11" rx=".75"/>
    </g>
  </defs>
</svg>
{% endmacro %}

